  photoPreview.src=url;
  photoPreview.style.display='block';
  alert('✅ Foto kelas berhasil dimuat! Sekarang muncul HD 100%!');
});

const a=document.getElementById('audio'),b=document.getElementById('playBtn'),s=document.getElementById('st');let p=false;a.volume=0.8;
